{
  // ==========================================================================
  // Basecamp MCP Server - Wrangler Configuration
  // ==========================================================================
  //
  // MULTI-TENANT ARCHITECTURE:
  // This server supports multiple tenants. Credentials are passed via request
  // headers, NOT stored as wrangler secrets. This allows a single deployment
  // to serve multiple customers.
  //
  // BASECAMP AUTHENTICATION:
  // - X-Basecamp-Access-Token: OAuth 2.0 access token (required)
  // - X-Basecamp-Account-ID: Basecamp account ID (required)
  // ==========================================================================

  "name": "primrose-mcp-basecamp",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat"],

  // ==========================================================================
  // Environment Variables (server-wide configuration, not per-tenant)
  // ==========================================================================
  "vars": {
    "CHARACTER_LIMIT": "50000",
    "DEFAULT_PAGE_SIZE": "15",
    "MAX_PAGE_SIZE": "100"
  },

  // ==========================================================================
  // Multi-Tenant Authentication (via Request Headers)
  // ==========================================================================
  //
  // Tenant credentials are passed via HTTP headers on each request:
  //
  // Required:
  //   X-Basecamp-Access-Token: OAuth 2.0 access token
  //   X-Basecamp-Account-ID: Basecamp account ID
  //
  // Basecamp API requires OAuth 2.0 authentication. Users must register
  // their application at https://launchpad.37signals.com/integrations

  // ==========================================================================
  // Development
  // ==========================================================================
  "dev": {
    "port": 8787,
    "local_protocol": "http"
  },

  "observability": {
    "enabled": true
  }
}
